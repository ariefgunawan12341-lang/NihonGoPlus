# Set VITE_USE_SUPABASE=true and fill these in to connect a real Supabase project.
# Leave VITE_USE_SUPABASE=false (or omit it) to run entirely on local mock data
# (localStorage) with zero setup — useful for development and demos.

VITE_USE_SUPABASE=false

# Project Settings -> API in the Supabase dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Required for Kaiwa AI (the AI conversation partner). This must NOT be
# prefixed with VITE_ — that would bundle it into client-side JS and expose
# it publicly. It is only read server-side by api/chat.ts (a Vercel
# serverless function). Set it in your Vercel project's environment
# variables when deploying, and in a local .env when using `vercel dev`.
ANTHROPIC_API_KEY=

# --- Used only by scripts/importSupabase.ts (the bulk seed importer) ---
# Project Settings -> API -> service_role key (NOT the anon key — this
# bypasses Row Level Security, so keep it out of any client-side code and
# never commit a real value here).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
