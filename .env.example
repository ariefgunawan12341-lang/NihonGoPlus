# NihonGoPlus Environment Variables
# Keep this file safe to commit and use only non-sensitive defaults.

# --- Frontend runtime (safe to expose in the browser) ---
VITE_USE_SUPABASE=true
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=ey...your-anon-key-starts-with-ey
VITE_APP_URL=https://nihongoplus.my.id
VITE_ENVIRONMENT=production

# --- Server-side / Cloudflare Pages Functions ---
# Required for Kaiwa AI endpoint.
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Scripts & Maintenance ---
# Local-only seed importer. Never expose service role keys in the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Or use SUPABASE_SECRET_KEY=your_service_role_secret if Supabase issues a secret key.
