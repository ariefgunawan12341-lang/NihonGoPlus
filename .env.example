# NihonGoPlus Environment Variables

# --- Database & Auth (Supabase) ---
# Set VITE_USE_SUPABASE=true to enable production backend
VITE_USE_SUPABASE=true

# Project Settings -> API in the Supabase dashboard
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- AI & External Services ---
# Required for Arif Boncel Sensei (Kaiwa AI).
# This must NOT be prefixed with VITE_ (server-side only in Vercel).
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Scripts & Maintenance ---
# Used only by scripts/importSupabase.ts (bulk seed importer)
# NEVER commit the service_role key to version control.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
